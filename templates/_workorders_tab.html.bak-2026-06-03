<script>
(function(){
    'use strict';

    /* ── State ── */
    var state = {
        user: '', role: '', canFieldOps: false, canManage: false,
        deliveryItems: [], machines: [],
        cscope: 'mine', csearch: '',
        fpane: 'jobs',
        apane: 'delivery', asearch: '',
        assignContext: null,
    };

    /* ── Utils ── */
    function $(id){ return document.getElementById(id); }
    function esc(s){
        return (s==null?"":String(s)).replace(/[&<>"']/g, function(c){
            return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c];
        });
    }
    function titleCase(s){ return (s||"").replace(/_/g," ").replace(/\b\w/g,function(c){return c.toUpperCase();}); }
    function fmtDateTime(iso){
        if(!iso) return "—";
        var d = new Date(iso); if(isNaN(d.getTime())) return "—";
        return d.toLocaleString("en-SG", {day:"2-digit",month:"short",year:"numeric",hour:"2-digit",minute:"2-digit"});
    }
    function fmtAge(iso){
        if(!iso) return "";
        var d = new Date(iso); if(isNaN(d.getTime())) return "";
        var mins = (Date.now()-d.getTime())/60000;
        if(mins < 1) return "just now";
        if(mins < 60) return Math.round(mins)+"m ago";
        if(mins < 1440) return Math.round(mins/60)+"h ago";
        return Math.round(mins/1440)+"d ago";
    }
    function toast(msg, isErr){
        var t = $("wo-toast"); t.textContent = msg;
        t.className = "wo-toast show" + (isErr ? " err" : "");
        setTimeout(function(){ t.className = "wo-toast"; }, 3200);
    }
    function api(url, opts){
        opts = opts || {};
        return fetch(url, opts).then(function(r){
            var isJson = (r.headers.get("Content-Type")||"").indexOf("json") >= 0;
            return r.text().then(function(txt){
                var data = {};
                if(isJson){ try { data = JSON.parse(txt); } catch(e){} }
                if(!r.ok) throw new Error((data && data.error) || ("Request failed ("+r.status+")"));
                return data;
            });
        });
    }
    function postJSON(url, body, method){
        return api(url, {
            method: method || "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify(body || {}),
        });
    }
    function openModal(id){ $(id).classList.add("open"); }
    function closeModal(id){ $(id).classList.remove("open"); }

    /* ── Bootstrap ── */
    function bootstrap(){
        return api("/api/wo/bootstrap").then(function(d){
            state.user = d.user; state.role = d.role;
            state.canFieldOps = !!d.can_field_ops;
            state.canManage = !!d.can_manage;
            state.deliveryItems = d.delivery_items || [];
            // Hide tabs the user can't use
            document.querySelectorAll(".wo-subtab-btn").forEach(function(b){
                var p = b.getAttribute("data-pane");
                var allowed = (p === "complaint") ||
                              (p === "fieldops"   && state.canFieldOps) ||
                              (p === "assignment" && state.canManage) ||
                              (p === "manager"    && state.canManage);
                if(!allowed) b.classList.add("hidden");
            });
            if(!state.canManage){ $("wo-cscope-all").style.display = "none"; }
        });
    }

    /* ── Sub-tab switching ── */
    $("wo-subtabs").addEventListener("click", function(e){
        var btn = e.target.closest(".wo-subtab-btn");
        if(!btn || btn.classList.contains("hidden")) return;
        document.querySelectorAll(".wo-subtab-btn").forEach(function(b){ b.classList.remove("active"); });
        btn.classList.add("active");
        var pane = btn.getAttribute("data-pane");
        document.querySelectorAll(".wo-pane").forEach(function(p){
            p.classList.toggle("active", p.getAttribute("data-pane") === pane);
        });
        if(pane === "complaint")  loadComplaints();
        if(pane === "fieldops")   loadFieldOps();
        if(pane === "assignment") loadAssignment();
        if(pane === "manager")    loadManager();
    });

    /* ── Machines (for selects) ── */
    function loadMachines(){
        if(state.machines.length) return Promise.resolve(state.machines);
        return api("/api/wo/machines").then(function(arr){
            state.machines = arr || []; return state.machines;
        });
    }
    function machineSelect(elId, includeBlank){
        var sel = $(elId);
        var opts = (includeBlank ? '<option value="">(no specific machine)</option>' : '<option value="">Select a machine…</option>');
        opts += state.machines.map(function(m, i){
            return '<option value="' + i + '">' + esc(m.name) + '</option>';
        }).join("");
        sel.innerHTML = opts;
    }
    function machineByIndex(i){
        var idx = parseInt(i, 10);
        return (isNaN(idx) || idx < 0 || idx >= state.machines.length) ? null : state.machines[idx];
    }

    /* ── COMPLAINTS ──────────────────────────────────────────────────── */
    document.querySelectorAll('[data-cscope]').forEach(function(b){
        b.addEventListener("click", function(){
            document.querySelectorAll('[data-cscope]').forEach(function(x){ x.classList.remove("active"); });
            b.classList.add("active");
            state.cscope = b.getAttribute("data-cscope");
            loadComplaints();
        });
    });
    var csearchTimer;
    $("wo-c-search").addEventListener("input", function(){
        clearTimeout(csearchTimer);
        csearchTimer = setTimeout(function(){
            state.csearch = $("wo-c-search").value.trim().toLowerCase();
            renderComplaintList(window._lastComplaints || []);
        }, 220);
    });
    function loadComplaints(){
        var msg = $("wo-c-msg"); msg.innerHTML = '<div class="wo-msg loading">Loading…</div>';
        $("wo-c-list").innerHTML = "";
        api("/api/wo/complaints?scope=" + encodeURIComponent(state.cscope))
            .then(function(rows){
                msg.innerHTML = "";
                window._lastComplaints = rows;
                renderComplaintList(rows);
            }).catch(function(err){
                msg.innerHTML = '<div class="wo-msg error">' + esc(err.message) + '</div>';
            });
    }
    function renderComplaintList(rows){
        var q = state.csearch;
        if(q){
            rows = rows.filter(function(c){
                var hay = (c.description + " " + (c.machine_name||"") + " " + (c.submitter||"")).toLowerCase();
                return hay.indexOf(q) >= 0;
            });
        }
        if(!rows.length){
            $("wo-c-list").innerHTML = '<div class="wo-empty">No complaints to show.</div>';
            return;
        }
        $("wo-c-list").innerHTML = rows.map(function(c){
            var desc = c.description.length > 110 ? c.description.slice(0, 110) + "…" : c.description;
            var impact = (c.impact_amount != null) ? (" · $" + Number(c.impact_amount).toFixed(2) + " impact") : "";
            var photos = c.image_count ? (' · ' + c.image_count + ' photo' + (c.image_count>1?"s":"")) : "";
            return '<div class="wo-row" onclick="window.__woOpenComplaint(' + c.id + ')">' +
                '<div><div class="name">' + esc(c.machine_name || "(no machine)") + '</div>' +
                '<div class="sub">' + esc(desc) + '</div>' +
                '<div class="sub">#' + c.id + ' · ' + esc(c.submitter) + ' · ' + fmtAge(c.submitted_at) + impact + photos + '</div></div>' +
                '<div class="right">' +
                '<span class="wo-badge src-' + c.source + '">' + (c.source==='customer_chat'?'CX chat':'Self') + '</span>' +
                '<span class="wo-badge status-' + c.status + '">' + esc(c.status.replace("_"," ")) + '</span>' +
                '</div></div>';
        }).join("");
    }

    $("wo-btn-new-complaint").addEventListener("click", function(){
        loadMachines().then(function(){ openComplaintForm(null); });
    });
    function openComplaintForm(existing){
        $("wo-cm-title").textContent = existing ? ("Complaint #" + existing.id) : "New complaint";
        $("wo-cm-sub").textContent = "";
        var body = $("wo-cm-body");
        if(existing){
            // detail view (read-only)
            var imgs = (existing.images || []).map(function(im){
                return '<div class="wo-thumb"><img src="/api/wo/images/' + im.id + '" onclick="window.__woLightbox(' + im.id + ')"></div>';
            }).join("");
            var jobLink = existing.job_order_id ? ('<div class="sub" style="margin-top:6px">Linked to Job Order #' + existing.job_order_id + '</div>') : "";
            var impact = "";

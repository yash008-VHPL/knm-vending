            if(existing.impact_amount != null) impact += '<div class="fld"><label>Impact $</label><div>$' + Number(existing.impact_amount).toFixed(2) + '</div></div>';
            var addBtn = '<div class="wo-add-photo" onclick="window.__woAddComplaintPhoto(' + existing.id + ')"><span class="plus">+</span><span>Add photo</span></div>';

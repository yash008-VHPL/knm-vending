    /* ── ASSIGNMENT (manager) ───────────────────────────────────────── */
    document.querySelectorAll('[data-apane]').forEach(function(b){
        b.addEventListener("click", function(){
            document.querySelectorAll('[data-apane]').forEach(function(x){ x.classList.remove("active"); });
            b.classList.add("active");
            state.apane = b.getAttribute("data-apane");
            $("wo-a-delivery").style.display = state.apane === "delivery" ? "" : "none";
            $("wo-a-joborder").style.display = state.apane === "joborder" ? "" : "none";
            loadAssignment();
        });
    });
    var asearchTimer;
    $("wo-a-search").addEventListener("input", function(){
        clearTimeout(asearchTimer);
        asearchTimer = setTimeout(function(){
            state.asearch = $("wo-a-search").value.trim().toLowerCase();
            renderAssignmentList();
        }, 220);
    });
    function loadAssignment(){
        $("wo-amsg").innerHTML = '<div class="wo-msg loading">Loading…</div>';
        var url = state.apane === "delivery"
            ? "/api/wo/assignment/delivery-candidates"
            : "/api/wo/assignment/joborder-candidates";
        api(url).then(function(rows){
            $("wo-amsg").innerHTML = "";
            window._lastAssign = rows;
            renderAssignmentList();
        }).catch(function(err){
            $("wo-amsg").innerHTML = '<div class="wo-msg error">' + esc(err.message) + '</div>';
        });
    }
    function renderAssignmentList(){
        var rows = (window._lastAssign || []).slice();
        if(state.asearch){
            rows = rows.filter(function(r){ return r.machine_name.toLowerCase().indexOf(state.asearch) >= 0; });
        }
        var container = state.apane === "delivery" ? $("wo-a-delivery") : $("wo-a-joborder");
        if(!rows.length){
            container.innerHTML = '<div class="wo-empty">No locations.</div>';
            return;
        }
        if(state.apane === "delivery"){
            container.innerHTML = rows.map(function(m){
                return '<div class="wo-row" onclick="window.__woStartAssign(\'delivery\',\'' + esc(m.machine_name).replace(/\'/g,"\\\'") + '\',\'' + esc(m.machine_code||"") + '\')">' +
                    '<div><div class="name">' + esc(m.machine_name) + '</div>' +
                    '<div class="sub">Last topup: ' + esc(m.last_topup||"never") + '</div></div>' +
                    '<div class="right"><strong style="font-size:1.1rem;color:#1a56db">' + m.vends_since + '</strong>' +
                    '<span style="font-size:0.7rem;color:#6b7280">vends since topup</span></div>' +
                    '</div>';
            }).join("");
        } else {
            container.innerHTML = rows.map(function(m){
                return '<div class="wo-row" onclick="window.__woStartAssign(\'joborder\',\'' + esc(m.machine_name).replace(/\'/g,"\\\'") + '\',\'' + esc(m.machine_code||"") + '\')">' +
                    '<div><div class="name">' + esc(m.machine_name) + '</div></div>' +
                    '<div class="right"><strong style="font-size:1.1rem;color:#c2410c">' + m.open_complaints + '</strong>' +
                    '<span style="font-size:0.7rem;color:#6b7280">open complaints</span></div>' +
                    '</div>';
            }).join("");
        }
    }
    window.__woStartAssign = function(kind, machineName, machineCode){
        state.assignContext = {kind: kind, machine_name: machineName, machine_code: machineCode || null};
        $("wo-am-title").textContent = (kind === "delivery" ? "Create delivery order" : "Create job order");
        $("wo-am-sub").textContent = machineName;
        var prefix = kind === "delivery" ? "Last topup minutiae, slot allocation, …" : "Suspected fault, special tools, …";
        var complaintPicker = "";
        if(kind === "joborder" && machineCode){
            // Fetch open complaints at this machine and let manager pick one to link.
            complaintPicker = '<div class="fld"><label>Link to complaint (optional)</label><select id="wo-am-complaint"><option value="">No complaint — manual job</option></select></div>';
        }
        $("wo-am-body").innerHTML =
            '<div class="wo-section-box wo-form">' + complaintPicker +
            '<div class="fld"><label>Notes</label><textarea id="wo-am-notes" placeholder="' + prefix + '"></textarea></div>' +
            '<div class="row2">' +
            '<div class="fld"><label>Assign to (operator email)</label><input type="email" id="wo-am-assign" placeholder="someone@kopinearme.com"></div>' +
            '<div class="fld"><label>Priority</label><select id="wo-am-prio"><option value="low">Low</option><option value="normal" selected>Normal</option><option value="high">High</option></select></div>' +
            '</div>' +
            '<div class="wo-actionbar">' +
            '<button class="btn btn-secondary btn-sm" data-wo-close="wo-assign-modal">Cancel</button>' +
            '<button class="btn btn-primary btn-sm" id="wo-am-submit">Create</button>' +
            '</div>' +
            '</div>';
        if(complaintPicker){
            api("/api/wo/complaints?scope=all&status=open").then(function(rows){
                var sel = $("wo-am-complaint"); if(!sel) return;
                var matching = rows.filter(function(c){
                    return (c.machine_code && c.machine_code === machineCode) || c.machine_name === machineName;
                });
                matching.forEach(function(c){
                    var opt = document.createElement("option");
                    opt.value = c.id;
                    opt.textContent = "#" + c.id + " — " + c.description.slice(0, 60);
                    sel.appendChild(opt);
                });
            });
        }
        $("wo-am-submit").addEventListener("click", submitAssignment);
        openModal("wo-assign-modal");
    };
    function submitAssignment(){
        var ctx = state.assignContext;
        var body = {
            machine_name: ctx.machine_name,
            machine_code: ctx.machine_code || "",
            notes: $("wo-am-notes").value.trim(),
            assigned_to: $("wo-am-assign").value.trim(),
            priority: $("wo-am-prio").value,
        };
        var url;
        if(ctx.kind === "delivery"){
            url = "/api/wo/deliveryorders";
        } else {
            url = "/api/wo/joborders";
            var cSel = $("wo-am-complaint");
            if(cSel && cSel.value) body.complaint_id = parseInt(cSel.value, 10);
        }
        $("wo-am-submit").disabled = true;
        postJSON(url, body).then(function(){
            toast("Created");
            closeModal("wo-assign-modal");
            loadAssignment();
        }).catch(function(err){ toast(err.message, true); })
        .finally(function(){ $("wo-am-submit").disabled = false; });
    }

    /* ── MANAGER VIEW ────────────────────────────────────────────────── */
    function loadManager(){
        api("/api/wo/manager/overview").then(function(d){
            renderManagerTable(d.job_orders, $("wo-mgr-jobs"), "joborder");
            renderManagerTable(d.delivery_orders, $("wo-mgr-deliveries"), "delivery");
        }).catch(function(err){
            $("wo-mgr-jobs").innerHTML = '<div class="wo-msg error">' + esc(err.message) + '</div>';
        });
    }
    function renderManagerTable(rows, container, kind){
        if(!rows.length){
            container.innerHTML = '<div class="wo-empty">None open.</div>';
            return;
        }
        var hdr = '<thead><tr><th>#</th><th>Machine</th><th>Assigned to</th><th>Priority</th><th>Status</th><th>Age</th><th></th></tr></thead>';
        var body = '<tbody>' + rows.map(function(r){
            return '<tr>' +
                '<td>#' + r.id + '</td>' +
                '<td>' + esc(r.machine_name) + '</td>' +
                '<td><input type="email" value="' + esc(r.assigned_to||"") + '" data-mgr-assign="' + r.id + '"></td>' +
                '<td><select data-mgr-prio="' + r.id + '">' +
                    ['low','normal','high'].map(function(p){
                        return '<option value="' + p + '"' + (p===r.priority?' selected':'') + '>' + p + '</option>';
                    }).join('') +
                '</select></td>' +
                '<td><span class="wo-badge status-' + r.status + '">' + esc(r.status.replace("_"," ")) + '</span></td>' +
                '<td>' + fmtAge(r.created_at) + '</td>' +
                '<td><button class="btn btn-secondary btn-sm" onclick="window.__woMgrSave(\'' + kind + '\',' + r.id + ')">Save</button></td>' +
                '</tr>';
        }).join("") + '</tbody>';
        container.innerHTML = '<table class="wo-mgr-table">' + hdr + body + '</table>';
    }
    window.__woMgrSave = function(kind, id){
        var assign = document.querySelector('[data-mgr-assign="' + id + '"]').value.trim();
        var prio   = document.querySelector('[data-mgr-prio="' + id + '"]').value;
        var url = (kind === "joborder")
            ? "/api/wo/joborders/" + id + "/assign"
            : "/api/wo/deliveryorders/" + id + "/assign";
        postJSON(url, {assigned_to: assign, priority: prio}).then(function(){
            toast("Updated");
            loadManager();
        }).catch(function(err){ toast(err.message, true); });
    };

    /* ── MANAGER VIEW sub-tab + Equipment Log ─────────────────────────── */
    document.querySelectorAll('[data-mpane]').forEach(function(b){
        b.addEventListener("click", function(){
            document.querySelectorAll('[data-mpane]').forEach(function(x){ x.classList.remove("active"); });
            b.classList.add("active");
            var p = b.getAttribute("data-mpane");
            $("wo-m-ops").style.display       = p === "ops"       ? "" : "none";
            $("wo-m-equipment").style.display = p === "equipment" ? "" : "none";
            if(p === "ops") loadManager();
        });
    });
    var eqSearchTimer;
    $("wo-eq-search").addEventListener("input", function(){
        clearTimeout(eqSearchTimer);
        eqSearchTimer = setTimeout(eqSearch, 250);
    });
    function eqSearch(){
        var q = $("wo-eq-search").value.trim();
        if(q.length < 2){ $("wo-eq-results").innerHTML = ""; return; }
        api("/api/wo/manager/machines?q=" + encodeURIComponent(q)).then(function(rows){
            if(!rows.length){
                $("wo-eq-results").innerHTML = '<div class="wo-empty" style="padding:14px">No matches.</div>';
                return;
            }
            $("wo-eq-results").innerHTML = rows.map(function(m){
                return '<div class="wo-eq-cand" onclick="window.__woEqOpen(\'' +
                    esc(m.code).replace(/\'/g, "\\\'") + '\')">' +
                    '<span class="name">' + esc(m.name) + '</span>' +
                    '<span class="code">#' + esc(m.code) + '</span>' +
                    '</div>';
            }).join("");
        }).catch(function(err){
            $("wo-eq-results").innerHTML = '<div class="wo-msg error">' + esc(err.message) + '</div>';
        });
    }
    window.__woEqOpen = function(code){
        $("wo-eq-results").innerHTML = "";
        $("wo-eq-search").value = "";
        $("wo-eq-card").innerHTML = '<div class="wo-msg loading">Loading log…</div>';
        api("/api/wo/manager/equipment-log?machine_code=" + encodeURIComponent(code))
            .then(renderEqCard)
            .catch(function(err){
                $("wo-eq-card").innerHTML = '<div class="wo-msg error">' + esc(err.message) + '</div>';
            });
    };
    function renderEqCard(d){
        var m = d.machine;
        var topup = m.last_topup ? fmtDateTime(m.last_topup) : "never";
        var card = '<div class="wo-section-box">' +
            '<h3 style="font-size:1rem;font-weight:700;color:#111827;margin:0">Machine #' + esc(m.code) + '</h3>' +
            '<div class="sub" style="font-size:0.82rem;color:#6b7280;margin-top:4px">' +
                (m.names.map(esc).join(" / ") || "—") + '</div>' +
            '<div class="wo-eq-stats">' +
                '<div class="wo-eq-stat"><div class="num">' + d.counts.complaints + '</div><div class="lbl">complaints</div></div>' +
                '<div class="wo-eq-stat"><div class="num">' + d.counts.job_orders + '</div><div class="lbl">job orders</div></div>' +
                '<div class="wo-eq-stat"><div class="num">' + d.counts.delivery_orders + '</div><div class="lbl">deliveries</div></div>' +
                '<div class="wo-eq-stat"><div class="num" style="font-size:0.92rem;font-weight:600;color:#374151">' + esc(topup) + '</div><div class="lbl">last topup</div></div>' +
            '</div></div>';

        if(!d.events.length){
            card += '<div class="wo-empty">No events recorded.</div>';
        } else {
            card += '<div class="wo-section-box">' +
                '<div class="wo-section-title">Timeline · most recent first</div>' +
                '<ul class="wo-timeline">' +
                d.events.map(function(ev){
                    var typeLabel = ev.type === "joborder" ? "Job" :
                                    ev.type === "deliveryorder" ? "Delivery" :
                                    "Complaint";
                    var typeClass = ev.type === "joborder" ? "type-job" :
                                    ev.type === "deliveryorder" ? "type-delivery" :
                                    "type-complaint";
                    var click = ev.type === "complaint"     ? "window.__woOpenComplaint(" + ev.id + ")" :
                                ev.type === "joborder"      ? "window.__woOpenJob(" + ev.id + ")" :
                                ev.type === "deliveryorder" ? "window.__woOpenDelivery(" + ev.id + ")" : "";
                    return '<li onclick="' + click + '">' +
                        '<div class="wo-tl-time">' + fmtDateTime(ev.at) + '</div>' +
                        '<div class="wo-tl-body">' +
                            '<span class="wo-badge ' + typeClass + '">' + typeLabel + ' #' + ev.id + '</span>' +
                            '<span class="wo-tl-action">' + esc(ev.action.replace("_"," ")) + '</span>' +
                            '<div class="wo-tl-summary">' + esc(ev.summary || "") + '</div>' +
                            (ev.by ? '<div class="wo-tl-by">' + esc(ev.by) + '</div>' : "") +
                        '</div></li>';
                }).join("") +
                '</ul></div>';
        }
        $("wo-eq-card").innerHTML = card;
    }

    /* ── Images ── */
    function compressImage(file, maxDim, quality){
        return new Promise(function(resolve, reject){
            var reader = new FileReader();
            reader.onload = function(e){
                var img = new Image();
                img.onload = function(){
                    var w = img.width, h = img.height;
                    if(w > maxDim || h > maxDim){
                        if(w >= h){ h = Math.round(h * maxDim / w); w = maxDim; }
                        else      { w = Math.round(w * maxDim / h); h = maxDim; }
                    }
                    var canvas = document.createElement("canvas");
                    canvas.width = w; canvas.height = h;
                    canvas.getContext("2d").drawImage(img, 0, 0, w, h);
                    resolve(canvas.toDataURL("image/jpeg", quality));
                };
                img.onerror = function(){ reject(new Error("Could not read image format.")); };
                img.src = e.target.result;
            };
            reader.onerror = function(){ reject(new Error("Could not read file.")); };
            reader.readAsDataURL(file);
        });
    }
    function pickAndUpload(parentType, parentId, stage){
        var inp = document.createElement("input");
        inp.type = "file"; inp.accept = "image/*";
        inp.onchange = function(){
            var f = inp.files[0]; if(!f) return;
            uploadImage(parentType, parentId, stage, f);
        };
        inp.click();
    }
    function uploadImage(parentType, parentId, stage, file){
        toast("Uploading photo…");
        return compressImage(file, 1600, 0.8).catch(function(){
            return new Promise(function(res, rej){
                if(file.size > 5*1024*1024) return rej(new Error("Image too large and could not be compressed."));
                var fr = new FileReader();
                fr.onload = function(){ res(fr.result); };
                fr.onerror = function(){ rej(new Error("Could not read file.")); };
                fr.readAsDataURL(file);
            });
        }).then(function(dataUrl){
            return postJSON("/api/wo/images", {
                parent_type: parentType, parent_id: parentId,
                stage: stage, data_url: dataUrl, file_name: file.name,
            });
        }).then(function(){
            toast("Photo added");
            // Refresh the open modal if any
            if(parentType === "complaint") window.__woOpenComplaint(parentId);
            else if(parentType === "joborder") window.__woOpenJob(parentId);
            loadComplaints();
        }).catch(function(err){ toast(err.message, true); });
    }
    window.__woLightbox = function(id){
        $("wo-lb-img").src = "/api/wo/images/" + id;
        $("wo-lightbox").classList.add("open");
    };
    window.__woDelImage = function(imgId, parentKind, parentId){
        if(!confirm("Delete this photo?")) return;
        api("/api/wo/images/" + imgId, {method: "DELETE"}).then(function(){
            toast("Deleted");
            if(parentKind === "complaint") window.__woOpenComplaint(parentId);
            else if(parentKind === "job") window.__woOpenJob(parentId);
        }).catch(function(err){ toast(err.message, true); });
    };

    /* ── Close modals on overlay click / data-wo-close ── */
    document.querySelectorAll(".wo-overlay").forEach(function(ov){
        ov.addEventListener("click", function(e){
            if(e.target === ov) ov.classList.remove("open");
        });
    });
    document.addEventListener("click", function(e){
        var btn = e.target.closest("[data-wo-close]");
        if(btn){ closeModal(btn.getAttribute("data-wo-close")); }
    });

    /* ── Init when the Work Orders tab is first activated ── */
    var initialized = false;
    window.__woInit = function(){
        if(initialized) return;
        initialized = true;
        bootstrap().then(loadComplaints).catch(function(err){
            $("wo-c-msg").innerHTML = '<div class="wo-msg error">' + esc(err.message) + '</div>';
        });
    };
})();
</script>

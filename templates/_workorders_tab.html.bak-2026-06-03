        }
        var jImgs = (j.images || []).map(function(im){
            return '<div class="wo-thumb"><img src="/api/wo/images/' + im.id + '" onclick="window.__woLightbox(' + im.id + ')">' +
                '<button class="del" onclick="event.stopPropagation();window.__woDelImage(' + im.id + ',\'job\',' + j.id + ')">&times;</button></div>';

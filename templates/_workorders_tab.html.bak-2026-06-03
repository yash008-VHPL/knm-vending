                '<div class="fld"><label>Source</label><div>' + (existing.source==='customer_chat'?'Customer chat':'Self') + '</div></div>' +
                '<div class="fld"><label>Machine</label><div>' + esc(existing.machine_name||'—') + '</div></div>' +
                '</div>' + impact +
                '<div class="fld"><label>Photos</label><div class="wo-img-grid">' + imgs + addBtn + '</div></div>' +
                '<div class="sub">Submitted by ' + esc(existing.submitter) + ' on ' + fmtDateTime(existing.submitted_at) + '</div>' + jobLink +
                '</div>';
        } else {
            body.innerHTML =
                '<div class="wo-section-box wo-form">' +
                '<div class="fld"><label>Description *</label><textarea id="wo-cf-desc" placeholder="What happened?"></textarea></div>' +
                '<div class="fld"><label>Source</label><div class="wo-radio">' +
                    '<label><input type="radio" name="wo-cf-src" value="self" checked> Self</label>' +
                    '<label><input type="radio" name="wo-cf-src" value="customer_chat"> Customer chat</label>' +
                '</div></div>' +
                '<div class="fld"><label>Machine (optional)</label><select id="wo-cf-machine"></select></div>' +
                '<div class="row2">' +
                '<div class="fld"><label>Impact description</label><textarea id="wo-cf-impact" placeholder="e.g. refund issued"></textarea></div>' +
                '<div class="fld"><label>Impact $ (optional)</label><input type="number" id="wo-cf-amount" step="0.01" min="0" placeholder="0.00"></div>' +
                '</div>' +
                '<div class="wo-actionbar"><button class="btn btn-primary btn-sm" id="wo-cf-submit">Submit complaint</button></div>' +
                '</div>';
            machineSelect("wo-cf-machine", true);
            $("wo-cf-submit").addEventListener("click", submitComplaint);
        }
        openModal("wo-complaint-modal");
    }
    function submitComplaint(){
        var idx = $("wo-cf-machine").value;
        var m = idx === "" ? null : machineByIndex(idx);
        var srcEl = document.querySelector('input[name="wo-cf-src"]:checked');
        var body = {
            description:  $("wo-cf-desc").value.trim(),
            source:       srcEl ? srcEl.value : "self",
            machine_name: m ? m.name : "",
            machine_code: m ? (m.code || "") : "",
            impact_description: $("wo-cf-impact").value.trim(),
            impact_amount: $("wo-cf-amount").value.trim() || null,
        };
        if(!body.description){ toast("Please describe the complaint.", true); return; }
        $("wo-cf-submit").disabled = true;
        postJSON("/api/wo/complaints", body).then(function(res){
            toast("Complaint submitted");
            closeModal("wo-complaint-modal");
            // Upload any pending photos
            var pending = window.__woPendingPhotos || [];
            window.__woPendingPhotos = [];
            var chain = Promise.resolve();
            pending.forEach(function(p){
                chain = chain.then(function(){
                    return uploadImage("complaint", res.id, "submission", p);
                });
            });
            chain.finally(loadComplaints);
        }).catch(function(err){
            toast(err.message, true);
        }).finally(function(){ $("wo-cf-submit").disabled = false; });
    }
    window.__woOpenComplaint = function(id){
        api("/api/wo/complaints/" + id).then(openComplaintForm)
            .catch(function(err){ toast(err.message, true); });
    };
    window.__woAddComplaintPhoto = function(id){
        pickAndUpload("complaint", id, "submission");
    };

    /* ── FIELD OPS — location-centric (work tagged under a location) ──── */
    function loadFieldOps(){
        $("wo-fmsg").innerHTML = '<div class="wo-msg loading">Loading…</div>';
        Promise.all([
            api("/api/wo/joborders?tab=mine"),
            api("/api/wo/deliveryorders?tab=mine"),
        ]).then(function(arr){
            $("wo-fmsg").innerHTML = "";
            renderLocationGroups(arr[0], arr[1]);
        }).catch(function(err){
            $("wo-fmsg").innerHTML = '<div class="wo-msg error">' + esc(err.message) + '</div>';
        });
    }
    function renderLocationGroups(jobs, deliveries){
        var groups = {};
        jobs.forEach(function(j){
            var k = j.machine_name || "(no machine)";
            if(!groups[k]) groups[k] = {jobs: [], deliveries: []};
            groups[k].jobs.push(j);
        });
        deliveries.forEach(function(d){
            var k = d.machine_name || "(no machine)";
            if(!groups[k]) groups[k] = {jobs: [], deliveries: []};
            groups[k].deliveries.push(d);
        });
        var names = Object.keys(groups).sort();
        var container = $("wo-f-locations");
        if(!names.length){
            container.innerHTML = '<div class="wo-empty">No work assigned to you.</div>';
            return;
        }
        container.innerHTML = names.map(function(name){
            var g = groups[name];
            var jc = g.jobs.length, dc = g.deliveries.length;
            var badges = "";
            if(jc) badges += '<span class="wo-badge type-job">' + jc + ' job' + (jc>1?"s":"") + '</span>';
            if(dc) badges += '<span class="wo-badge type-delivery">' + dc + ' delivery' + (dc===1?"":"s") + '</span>';
            var any = g.jobs.concat(g.deliveries);
            if(any.some(function(x){ return x.priority === "high"; })){
                badges += '<span class="wo-badge prio-high">High</span>';
            }
            var orderRows = g.jobs.map(function(j){
                var photos = j.image_count ? (' · ' + j.image_count + ' photo' + (j.image_count>1?"s":"")) : "";
                return '<div class="wo-suborder" onclick="event.stopPropagation();window.__woOpenJob(' + j.id + ')">' +
                    '<span class="wo-badge type-job">Job</span>' +
                    '<span class="wo-sub-name">#' + j.id + '</span>' +
                    '<span class="wo-sub-info">' + fmtAge(j.created_at) + photos + '</span>' +
                    '<span class="wo-badge prio-' + j.priority + '">' + esc(j.priority) + '</span>' +
                    '<span class="wo-badge status-' + j.status + '">' + esc(j.status.replace("_"," ")) + '</span>' +
                    '</div>';
            }).join("") + g.deliveries.map(function(d){
                return '<div class="wo-suborder" onclick="event.stopPropagation();window.__woOpenDelivery(' + d.id + ')">' +
                    '<span class="wo-badge type-delivery">Delivery</span>' +
                    '<span class="wo-sub-name">#' + d.id + '</span>' +
                    '<span class="wo-sub-info">' + fmtAge(d.created_at) + '</span>' +
                    '<span class="wo-badge prio-' + d.priority + '">' + esc(d.priority) + '</span>' +
                    '<span class="wo-badge status-' + d.status + '">' + esc(d.status.replace("_"," ")) + '</span>' +
                    '</div>';
            }).join("");
            return '<div class="wo-loc open">' +
                '<div class="wo-loc-head" onclick="this.parentNode.classList.toggle(\'open\')">' +
                '<span class="wo-loc-name">' + esc(name) + '</span>' +
                '<span class="wo-loc-badges">' + badges + '</span>' +
                '<span class="wo-loc-chev">▾</span>' +
                '</div>' +
                '<div class="wo-loc-orders">' + orderRows + '</div>' +
                '</div>';
        }).join("");
    }

    window.__woOpenJob = function(id){
        api("/api/wo/joborders/" + id).then(renderJobModal)
            .catch(function(err){ toast(err.message, true); });
    };
    function renderJobModal(j){
        $("wo-jm-title").textContent = "#" + j.id + " — " + j.machine_name;
        $("wo-jm-sub").textContent = "Assigned: " + (j.assigned_to || "(unassigned)") + " · " + titleCase(j.status);
        var c = j.complaint;
        var complaintBlock = "";
        if(c){
            var cImgs = (c.images || []).map(function(im){
                return '<div class="wo-thumb"><img src="/api/wo/images/' + im.id + '" onclick="window.__woLightbox(' + im.id + ')"></div>';
            }).join("");
            complaintBlock =
                '<div class="wo-section-box">' +
                '<div class="wo-section-title">Submitter’s complaint</div>' +
                '<div class="fld"><label>Description</label><div>' + esc(c.description) + '</div></div>' +
                (c.impact_description ? '<div class="fld"><label>Impact</label><div>' + esc(c.impact_description) + '</div></div>' : "") +
                (c.impact_amount != null ? '<div class="fld"><label>Impact $</label><div>$' + Number(c.impact_amount).toFixed(2) + '</div></div>' : "") +
                (cImgs ? '<div class="fld"><label>Photos</label><div class="wo-img-grid">' + cImgs + '</div></div>' : "") +

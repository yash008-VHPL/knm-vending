    window.__woQtyStep = function(idx, delta){
        var el = $("wo-d-qty-" + idx);
        var v = parseInt(el.textContent, 10) || 0;
        v = Math.max(0, Math.min(20, v + delta));
        el.textContent = v;
    };
    function readQtys(){
        var qs = [];
        for(var i = 1; i <= 8; i++){ qs.push(parseInt($("wo-d-qty-" + i).textContent, 10) || 0); }
        return qs;
    }
    window.__woSaveDelivery = function(id){
        postJSON("/api/wo/deliveryorders/" + id, {
            quantities: readQtys(),
            recipient_name: $("wo-d-recip").value.trim(),
        }, "PATCH").then(function(){
            toast("Saved"); loadFieldOps();
        }).catch(function(err){ toast(err.message, true); });
    };
    window.__woCompleteDelivery = function(id){
        var recip = $("wo-d-recip").value.trim();
        if(!recip){ toast("Add the recipient name before completing.", true); return; }
        if(!confirm("Complete this delivery for recipient \"" + recip + "\"?")) return;
        // Save first, then complete
        postJSON("/api/wo/deliveryorders/" + id, {
            quantities: readQtys(),
            recipient_name: recip,
        }, "PATCH").then(function(){
            return postJSON("/api/wo/deliveryorders/" + id + "/complete", {});
        }).then(function(res){
            toast(res.topup_note || "Completed");
            closeModal("wo-delivery-modal");
            loadFieldOps();
        }).catch(function(err){ toast(err.message, true); });

        var canEdit = state.canFieldOps && j.status !== "completed";
        var ro = canEdit ? "" : "readonly";
        var actionBtns = "";
        if(canEdit){
            actionBtns += '<button class="btn btn-primary btn-sm" onclick="window.__woSaveJob(' + j.id + ')">Save</button>';
            actionBtns += '<button class="btn btn-success btn-sm" onclick="window.__woCompleteJob(' + j.id + ')">Mark complete</button>';
        }
        if(state.canFieldOps && j.status === "completed"){
            actionBtns += '<button class="btn btn-secondary btn-sm" onclick="window.__woReopenJob(' + j.id + ')">Reopen</button>';
        }
        $("wo-jm-body").innerHTML = complaintBlock +
            '<div class="wo-section-box wo-form">' +
            '<div class="wo-section-title">Report &amp; resolution</div>' +
            '<div class="fld"><label>Report</label><textarea id="wo-j-report" ' + ro + '>' + esc(j.report||"") + '</textarea></div>' +
            '<div class="fld"><label>Root cause</label><textarea id="wo-j-root" ' + ro + '>' + esc(j.root_cause||"") + '</textarea></div>' +
            '<div class="fld"><label>Corrective action</label><textarea id="wo-j-corr" ' + ro + '>' + esc(j.corrective_action||"") + '</textarea></div>' +
            '<div class="fld"><label>Preventive action</label><textarea id="wo-j-prev" ' + ro + '>' + esc(j.preventive_action||"") + '</textarea></div>' +
            '<div class="fld"><label>Photos</label><div class="wo-img-grid">' + jImgs +
                (canEdit ? '<div class="wo-add-photo" onclick="window.__woAddJobPhoto(' + j.id + ')"><span class="plus">+</span><span>Add photo</span></div>' : '') +
            '</div></div>' +
            '<div class="wo-actionbar">' + actionBtns + '</div>' +
            '</div>';
        openModal("wo-job-modal");
    }
    window.__woSaveJob = function(id){
        postJSON("/api/wo/joborders/" + id, {
            report:            $("wo-j-report").value.trim(),
            root_cause:        $("wo-j-root").value.trim(),
            corrective_action: $("wo-j-corr").value.trim(),
            preventive_action: $("wo-j-prev").value.trim(),
        }, "PATCH").then(function(){
            toast("Saved");
            window.__woOpenJob(id);
            loadFieldOps();
        }).catch(function(err){ toast(err.message, true); });
    };
    window.__woCompleteJob = function(id){
        if(!confirm("Mark this job order complete?")) return;
        // Save first, then complete
        postJSON("/api/wo/joborders/" + id, {
            report:            $("wo-j-report").value.trim(),
            root_cause:        $("wo-j-root").value.trim(),
            corrective_action: $("wo-j-corr").value.trim(),
            preventive_action: $("wo-j-prev").value.trim(),
        }, "PATCH").then(function(){
            return postJSON("/api/wo/joborders/" + id + "/status", {status: "completed"});
        }).then(function(){
            toast("Completed");
            closeModal("wo-job-modal");
            loadFieldOps();
        }).catch(function(err){ toast(err.message, true); });
    };
    window.__woReopenJob = function(id){
        postJSON("/api/wo/joborders/" + id + "/status", {status: "in_progress"}).then(function(){
            toast("Reopened"); window.__woOpenJob(id); loadFieldOps();
        }).catch(function(err){ toast(err.message, true); });
    };
    window.__woAddJobPhoto = function(id){ pickAndUpload("joborder", id, "report"); };

    window.__woOpenDelivery = function(id){
        api("/api/wo/deliveryorders/" + id).then(renderDeliveryModal)
            .catch(function(err){ toast(err.message, true); });
    };
    function renderDeliveryModal(d){
        $("wo-dm-title").textContent = "#" + d.id + " — " + d.machine_name;
        $("wo-dm-sub").textContent = "Assigned: " + (d.assigned_to || "(unassigned)") + " · " + titleCase(d.status);

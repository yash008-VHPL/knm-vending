@workorders_bp.route("/joborders/<int:jid>", methods=["PATCH"])
@require_roles(*OPERATOR_ROLES)
def api_joborder_update(jid):
    """Operator (or manager/admin) fills Report / Root Cause / Corrective / Preventive."""
    data = request.get_json(silent=True) or {}
    fields = {}
    for k_in, k_db in (("report", "Report"), ("root_cause", "RootCause"),
                       ("corrective_action", "CorrectiveAction"),
                       ("preventive_action", "PreventiveAction")):
        if k_in in data:
            v = data.get(k_in)
            fields[k_db] = (v.strip() or None) if isinstance(v, str) else v
    if not fields:
        return jsonify({"error": "Nothing to update."}), 400
    user = get_current_user()
    try:
        conn = get_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT Status, AssignedTo FROM WO_JobOrders WHERE JobOrderID = %s", (jid,))
        row = cursor.fetchone()
        if not row:
            conn.close()
            return jsonify({"error": "Job order not found."}), 404
        # operators may only edit their own assignments; managers/admins may edit any
        role = get_role(user)
        if role == ROLE_OPERATOR and (row[1] or "").lower() != user:
            conn.close()
            return jsonify({"error": "You can only edit job orders assigned to you."}), 403

        set_clause = ", ".join(f"{col} = %s" for col in fields)
        params = list(fields.values())
        # Auto-advance status open -> in_progress on first repair edit
        if row[0] == "open":
            set_clause += ", Status = 'in_progress'"
        params.append(jid)
        cursor.execute(f"UPDATE WO_JobOrders SET {set_clause} WHERE JobOrderID = %s", tuple(params))

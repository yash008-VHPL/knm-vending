@workorders_bp.route("/complaints", methods=["POST"])
@api_login_required
def api_complaint_create():
    data = request.get_json(silent=True) or {}
    desc = (data.get("description") or "").strip()
    if not desc:
        return jsonify({"error": "Please describe the complaint."}), 400
    source = (data.get("source") or "self").strip().lower()
    if source not in ("self", "customer_chat"):
        source = "self"
    impact_desc = (data.get("impact_description") or "").strip() or None
    impact_amt_raw = data.get("impact_amount")
    impact_amt = None
    if impact_amt_raw not in (None, "", "null"):
        try:
            impact_amt = float(impact_amt_raw)
        except (TypeError, ValueError):
            return jsonify({"error": "Impact amount must be a number."}), 400
    machine_name = (data.get("machine_name") or "").strip() or None
    machine_code = (data.get("machine_code") or "").strip() or None
    user = get_current_user()
    try:
        conn = get_connection()
        cursor = conn.cursor()
        cursor.execute("""
            INSERT INTO WO_Complaints
                (Description, Source, ImpactDescription, ImpactAmount,
                 MachineName, MachineCode, SubmitterEmail)
            OUTPUT INSERTED.ComplaintID
            VALUES (%s, %s, %s, %s, %s, %s, %s)
        """, (desc, source, impact_desc, impact_amt, machine_name, machine_code, user))
        new_id = cursor.fetchone()[0]
        _log_activity(cursor, "complaint", new_id, "submitted", "Complaint submitted", user)
        conn.commit()
        conn.close()
        return jsonify({"ok": True, "id": new_id})
    except Exception as e:
        return jsonify({"error": f"Database error: {str(e)}"}), 500



def _verify_parent(cursor, parent_type, parent_id):
    table = {"complaint": "WO_Complaints",
             "joborder":  "WO_JobOrders"}.get(parent_type)
    if not table:
        return False
    id_col = {"complaint": "ComplaintID", "joborder": "JobOrderID"}[parent_type]
    cursor.execute(f"SELECT 1 FROM {table} WHERE {id_col} = %s", (parent_id,))
    return cursor.fetchone() is not None


@workorders_bp.route("/images", methods=["POST"])
@api_login_required
def api_image_upload():
    """Body: {parent_type, parent_id, stage, data_url, file_name}.

    Permissions:
      complaint/submission  — any signed-in user (the submitter or anyone helping triage)
      joborder/report       — operator/field_manager/admin
    """
    data = request.get_json(silent=True) or {}
    parent_type = (data.get("parent_type") or "").strip().lower()
    try:
        parent_id = int(data.get("parent_id"))
    except (TypeError, ValueError):
        return jsonify({"error": "Invalid parent id."}), 400
    stage = (data.get("stage") or "").strip().lower() or (
        "submission" if parent_type == "complaint" else "report")
    file_name = (data.get("file_name") or "").strip()[:255] or None

    if parent_type not in ("complaint", "joborder"):
        return jsonify({"error": "Invalid parent type."}), 400

    if parent_type == "joborder":
        # Only operator+ can upload repair photos.
        role = get_role(get_current_user())
        if role not in OPERATOR_ROLES:
            return jsonify({"error": "Only operators and managers can add repair photos."}), 403

    raw, content_type = _decode_data_url(data.get("data_url") or "")
    if raw is None:
        return jsonify({"error": "Invalid image data."}), 400
    if len(raw) > 6 * 1024 * 1024:
        return jsonify({"error": "Image is too large (6 MB max after compression)."}), 400

    user = get_current_user()
    try:
        conn = get_connection()
        cursor = conn.cursor()
        if not _verify_parent(cursor, parent_type, parent_id):
            conn.close()
            return jsonify({"error": "Parent record not found."}), 404
        cursor.execute("""
            INSERT INTO WO_Images
                (ParentType, ParentID, Stage, ImageData, ContentType, FileName, UploadedBy)
            OUTPUT INSERTED.ImageID
            VALUES (%s, %s, %s, %s, %s, %s, %s)
        """, (parent_type, parent_id, stage, raw, content_type, file_name, user))
        img_id = cursor.fetchone()[0]
        _log_activity(cursor, parent_type, parent_id, "image_added",
                      f"{stage.capitalize()} photo added", user)
        conn.commit()
        conn.close()
        return jsonify({"ok": True, "id": img_id})
    except Exception as e:
        return jsonify({"error": f"Database error: {str(e)}"}), 500


@workorders_bp.route("/images/<int:image_id>")
@api_login_required
def api_image_get(image_id):
    try:
        conn = get_connection()
        cursor = conn.cursor()
        cursor.execute(
            "SELECT ImageData, ContentType FROM WO_Images WHERE ImageID = %s",
            (image_id,),
        )
        row = cursor.fetchone()
        conn.close()
    except Exception as e:
        return jsonify({"error": f"Database error: {str(e)}"}), 500
    if not row:
        return jsonify({"error": "Image not found."}), 404
    data = row[0]
    if isinstance(data, str):
        data = data.encode("latin-1")
    return Response(
        bytes(data),
        mimetype=(row[1] or "image/jpeg"),
        headers={"Cache-Control": "private, max-age=86400"},
    )


@workorders_bp.route("/images/<int:image_id>", methods=["DELETE"])
@api_login_required
def api_image_delete(image_id):
    user = get_current_user()
    role = get_role(user)
    try:
        conn = get_connection()
        cursor = conn.cursor()
        cursor.execute(
            "SELECT ParentType, ParentID, UploadedBy FROM WO_Images WHERE ImageID = %s",
            (image_id,),
        )
        row = cursor.fetchone()
        if not row:
            conn.close()
            return jsonify({"error": "Image not found."}), 404
        if role not in MANAGER_ROLES and (row[2] or "").lower() != user:
            conn.close()
            return jsonify({"error": "You can only delete photos you uploaded."}), 403
        cursor.execute("DELETE FROM WO_Images WHERE ImageID = %s", (image_id,))
        _log_activity(cursor, row[0], row[1], "image_removed", "Photo removed", user)
        conn.commit()
        conn.close()
        return jsonify({"ok": True})
    except Exception as e:
        return jsonify({"error": f"Database error: {str(e)}"}), 500

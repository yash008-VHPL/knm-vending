                   Status, SubmitterEmail, SubmittedAt, JobOrderID
            FROM WO_Complaints WHERE MachineCode = %s
        """, (code,))
        complaint_ids = []
        for r in cursor.fetchall():
            complaint_ids.append(r[0])
            summary = (r[1] or "")[:120]
            if r[4] is not None:
                summary += f" (impact ${float(r[4]):.2f})"
            events.append({
                "at": _iso(r[7]), "type": "complaint", "id": r[0],
                "action": "submitted", "by": r[6], "summary": summary,
                "status": r[5], "linked_job_order": r[8],
            })

